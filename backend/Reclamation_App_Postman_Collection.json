            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Créer un compte utilisateur simple avec rôle USER."
          },
          "response": []
        },
        {
          "name": "4. Change Password",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password?userId=admin001&oldPassword=Admin@123&newPassword=NewAdmin@456",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"],
              "query": [
                {
                  "key": "userId",
                  "value": "admin001"
                },
                {
                  "key": "oldPassword",
                  "value": "Admin@123"
                },
                {
                  "key": "newPassword",
                  "value": "NewAdmin@456"
                }
              ]
            },
            "description": "Changer le mot de passe d'un utilisateur."
          },
          "response": []
        }
      ],
      "description": "Endpoints d'authentification (publics)"
    },
